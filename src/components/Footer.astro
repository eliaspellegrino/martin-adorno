---
import { site } from "../data/site";
---

<footer class="border-t border-line py-10 text-sm text-white/60">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="font-bold text-white">{site.name}</div>
      <div>{site.tagline} · {site.city}</div>
    </div>
    <div class="flex flex-wrap gap-5">
      <a class="hover:text-white" href={site.instagram} rel="noopener" target="_blank">Instagram {site.instagramHandle}</a>
      <a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div class="text-xs text-white/40">© {new Date().getFullYear()} {site.name}</div>
  </div>
</footer>
