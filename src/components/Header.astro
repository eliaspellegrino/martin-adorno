---
import { site } from "../data/site";
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href="/" class="font-bold tracking-tight text-white">{site.name}</a>
    <nav aria-label="Principal" class="flex items-center gap-5 text-sm text-white/75">
      <a href="/#planes" class="hover:text-white">Planes</a>
      <a href="/online" class="hover:text-white">Online</a>
      <a href="/#faq" class="hidden hover:text-white sm:inline">Preguntas</a>
      <a href="/#contacto" class="rounded-full bg-accent px-4 py-2 font-semibold text-black hover:bg-accent-strong">Contacto</a>
    </nav>
  </div>
</header>
