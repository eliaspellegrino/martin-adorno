---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import iconSource from "../assets/martin-square.png";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = "/" } = Astro.props;
const canonical = new URL(path, site.url).toString();
const icon = await getImage({ src: iconSource, width: 64, height: 64, format: "png" });
const ogImage = await getImage({ src: iconSource, width: 512, height: 512, format: "png" });
const ogUrl = new URL(ogImage.src, site.url).toString();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={icon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-black"
      >Saltar al contenido</a
    >
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Agrega el origen de campaña (?c=meta1) al mensaje de WhatsApp para poder
      // identificar de dónde llega cada consulta. Lo guarda mientras dura la
      // pestaña para no perderlo al cambiar de página. No envía nada a terceros.
      (function () {
        var clean = function (v) {
          return (v || "").replace(/[^a-z0-9_-]/gi, "").slice(0, 24);
        };
        var c = clean(new URLSearchParams(location.search).get("c"));
        // El almacenamiento puede estar bloqueado: en ese caso vale solo la URL.
        try {
          if (c) sessionStorage.setItem("c", c);
          else c = clean(sessionStorage.getItem("c"));
        } catch (e) {}
        if (!c) return;
        document.querySelectorAll("a[data-wa]").forEach(function (a) {
          var url = new URL(a.href);
          var text = url.searchParams.get("text") || "";
          // encodeURIComponent: searchParams.set escribiría los espacios como "+".
          url.search = "?text=" + encodeURIComponent(text + " [ref: " + c + "]");
          a.href = url.toString();
        });
      })();
    </script>
  </body>
</html>
