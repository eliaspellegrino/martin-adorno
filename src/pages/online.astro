---
import Base from "../layouts/Base.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const includes = [
  "Rutina de entrenamiento adaptada a tu nivel y a dónde entrenás (casa o gimnasio)",
  "Plan de alimentación personalizado",
  "Seguimiento semanal por WhatsApp",
  "La rutina se actualiza cuando lo pedís; la dieta se cambia si te estancás",
];
const steps = [
  "Escribime por WhatsApp y contame tu objetivo.",
  "Te confirmo el plan y el medio de pago.",
  "Pagás el primer mes y recibís tu rutina y tu plan de alimentación.",
  "Seguimos por WhatsApp una vez por semana.",
];
---

<Base
  title="Entrenamiento online con seguimiento por WhatsApp · Martín Adorno"
  description="Plan online de rutina y alimentación personalizadas, con seguimiento semanal por WhatsApp. USD 75 por mes. Pago por PayPal o USDT."
  path="/online"
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Plan online · Starter</p>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
      Rutina y alimentación personalizadas, con seguimiento semanal
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-white/80">
      Entrená desde donde estés. Yo armo tu plan y lo seguimos juntos por WhatsApp.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <WhatsAppButton message="Hola Martín! Vi tu web y quiero consultar por el plan online.">Consultar por WhatsApp</WhatsAppButton>
      <p class="text-sm text-white/60">Respondo en español y, por mensaje, también en inglés.</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-4xl gap-6 px-5 pb-16 md:grid-cols-2" aria-label="Detalle del plan">
    <div class="rounded-2xl border border-line bg-panel p-6">
      <h2 class="text-lg font-bold text-white">Qué incluye</h2>
      <ul class="mt-4 space-y-3 text-sm text-white/80">
        {includes.map((i) => <li class="flex gap-2"><span aria-hidden="true" class="text-accent">✓</span><span>{i}</span></li>)}
      </ul>
    </div>
    <div class="rounded-2xl border border-line bg-panel p-6">
      <h2 class="text-lg font-bold text-white">Precio y pago</h2>
      <p class="mt-3 text-3xl font-extrabold text-white">USD 75 <span class="text-base font-normal text-white/55">por mes</span></p>
      <p class="mt-3 text-sm text-white/75">Pago por PayPal o en USDT. Pueden aplicarse comisiones del medio de pago.</p>
      <p class="mt-3 text-sm text-white/55">Si vivís en Argentina, el mismo plan cuesta ARS 75.000 por mes (ver <a class="underline" href="/#planes">planes</a>).</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-16" aria-labelledby="como">
    <h2 id="como" class="text-2xl font-bold text-white">Cómo empezar</h2>
    <ol class="mt-6 space-y-3 text-white/80">
      {steps.map((s, i) => <li class="flex gap-3"><span class="font-bold text-accent">{i + 1}.</span><span>{s}</span></li>)}
    </ol>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-20" aria-labelledby="horarios">
    <h2 id="horarios" class="text-2xl font-bold text-white">Idioma y horarios</h2>
    <p class="mt-4 max-w-2xl text-white/75">
      Atiendo en español, y por mensaje también en inglés. No respondo entre las 00:00 y las 08:00 (hora de Argentina, UTC−3); te contesto apenas arranque el día.
    </p>
    <div class="mt-8">
      <WhatsAppButton message="Hola Martín! Vi tu web y quiero consultar por el plan online.">Escribime por WhatsApp</WhatsAppButton>
    </div>
  </section>
</Base>
